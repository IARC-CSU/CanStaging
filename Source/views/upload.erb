<script src="/vendor/ladda/spin.min.js"></script>
<script src="/vendor/ladda/ladda.min.js"></script>
<link rel="stylesheet" href="/vendor/ladda/ladda.min.css">

<h1><%= R18n.t[:upload][:upload_header] %></h1>
<div>
	<%= R18n.t[:upload][:description] %>
</div>
<br>
<form action='/upload' method='post' class="form-inline well" enctype='multipart/form-data' id="upload-form">
  <input type="file" name='myfile' autofocus>
  <button class="ladda-button" data-style="expand-right" data-color="green" data-size="s"><span class="ladda-label"><%= R18n.t[:upload][:upload_button] %></span></button>
  <br>
  <br>
  <%= R18n.t[:upload][:separating_character] %> <input type="text" name='col_sep' value=',' maxlength="3" size="1" style="width: 30px;">
  <%= R18n.t[:upload][:quoting_character] %> <input type="text" name='quotes' value='"' maxlength="1" size="1" style="width: 30px;">
</form>

<script type="text/javascript">
	Ladda.bind("button");
</script>