<html>
<head>
  <title><%= site.site %></title>
  <link rel="stylesheet" href="/css/default.css" type="text/css">
  <script src="/js/jquery-1.9.1.min.js" type="text/javascript"></script>
  <!-- Not sure if we need this and it is rather heavy... <script src="/js/jquery-ui.min.js" type="text/javascript"></script> -->
  <script src="/js/serializeJSON.js" type="text/javascript"></script>
</head>
<body>
   
  <h1><%= site.site %></h1>
  <form name="tnm_form" action="/tnm" method="post" onsubmit="return validateForm()" id = "tnm_form">
    <input name="site" value="<%= site.site %>" hidden = true type = "hidden">
    <input name="key" value="<%= params[:key] %>" hidden = true type = "hidden">
    <table id = <%= "\"#{site.site.downcase}_form\"" %> >
      <% site.get_metas.each do |part, meta| %>
        <% unless meta.fields.empty? %>
        <thead>
        <tr id = "<%= part %>" onclick = "hide_unhide('<%= part %>')">
          <th><%= part %></th>
          <th id = "<%= part %>_result">
          </th>
        </tr>
        <tbody id = "<%= part %>">
        <% meta.fields.values.sort_by(&:group).each do |field| %>
          <% unless field.type == :generated %>
            <tr id = "<%= site.site.downcase+"_group_" + (field.group.nil? ? "1" : field.group) %>">
              <td><%= field.display_text %></td>
              <% case field.type 
                 when :boolean %>
                 <td>
                  <input type="radio" name=<%= "\"data[#{part}[#{field.name}]]\"" %> value="T" onchange = "change('<%= part %>')">Yes
                  <input type="radio" name=<%= "\"data[#{part}[#{field.name}]]\"" %> value="F" onchange = "change('<%= part %>')">No
                  </td>
              <% when :dictionary %>
              <td>
                  <select name=<%= "\"data[#{part}[#{field.name}]]\"" %> onchange = "change('<%= part %>')">
                    <option value='' disabled selected style='display:none;'>Please Choose</option>
                    <% field.dictionary.table.each do |key, value| %>
                      <option value=<%= "\"#{key}\"" %>><%= value %></option>
                    <% end %>
                  </select>
                  </td>
              <% when :number %>
              <td>
                <input name=<%= "\"data[#{part}[#{field.name}-number]]\"" %> type="number" step = <%= field.ranges.float? ? 0.1 : 1 %> min = <%= field.ranges.min_min %> max = <%= field.ranges.max_max %> title=<%= "\"#{field.ranges}\"" %> onchange = "change('<%= part %>')"/>
                </td>
              <% when :output %>
                  <td id = "<%= part + '_' + field.name %>_result"></td>
              <% else %>
              <td>
                <input name=<%= "\"data[#{part}[#{field.name}]]\"" %> type="text"  onchange = "change('<%= part %>')"/>
                </td>
              <% end %>
            </tr>
          <% end %>

        <% end %>

      <% end %>
      </tbody>
      <% end %>
      <tr id = "result">
        <th>TNM</th>
        <th id = "tnm_result"></th>
      </tr>
    </table>
    <input type="submit" value="Calculate" />
  </form>
  </body>

  <script type="text/javascript">
    function hide_unhide(part) {
     $('tbody#'+part).toggle( {easing: 'swing'} ); 
     /*$('tbody#'+part).toggle( 'scale', { percent: 0 }, 500 );*/
    }
  </script>

  <script type="text/javascript">
    function validateForm()
    {
      <% site.get_metas.each do |part, meta| %>
        <% meta.fields.values.each do |field| %>
          <% case field.type 
          when :boolean %>
            var radios = document.getElementsByName(<%= "\"data[#{part}[#{field.name}]]\"" %>);
            var formValid = false;
            var i = 0;
            while (!formValid && i < radios.length) {
                if (radios[i].checked) formValid = true;
                i++;        
            }
            if (!formValid) { alert (<%= "\" '#{field.display_text}' must be checked.\"" %>);
              return false;
            }
          <% when :number %>
            var x = document.forms["tnm_form"][<%= "\"data[#{part}[#{field.name}-number]]\"" %>].value;
            if (x==null || x=="")
            {
            alert(<%= "\" '#{field.display_text}' must be filled out.\"" %>);
            return false;
            }
              if (x < <%=field.ranges.min_min%> || x > <%=field.ranges.max_max%>) { alert (<%= "\" '#{field.display_text}' outside of scope (#{field.ranges}).\"" %>); 
              return false;
            } 
          <% else %>
            var x = document.forms["tnm_form"][<%= "\"data[#{part}[#{field.name}]]\"" %>].value;
            if (x==null || x=="")
            {
            alert(<%= "\" '#{field.display_text}' must be filled out.\"" %>);
            return false;
            }
          <% end %>
        <% end %>
      <% end %>
    }
  </script>

  <script type="text/javascript">
    /* attach a submit handler to the form */
    $("#tnm_form").submit(function(event) {
     
      /* stop form from submitting normally */
      event.preventDefault();

      var term = $('#tnm_form').serializeJSON();
      console.log(term);

    $.post('/tnm', term, 
      function(data) {
        console.log(data);
        var el = document.getElementById('tnm_result');
        var text = data["TNM"][0]["Result"];
        if (data["TNM"].length>1) text = text + " (non coclusive)"
        el.innerHTML = text
        var alert_text = "TNM: " + text + "\n"

        el = document.getElementById('SG_result');
        text = data["SG"][0]["Result"];
        el.innerHTML = text
        alert_text += "SG:  " + text + "\n"

        for (var key in data["SG"][0]) {
          if (key != "Result" && key != "Message") {
            el = document.getElementById('SG_' + key + '_result');
            text = data["SG"][0][key];
            el.innerHTML = text
            alert_text += key + ": " + text + "\n"
          }
        }

        alert(alert_text)
        }, "json");

    });
  </script>

  <script type="text/javascript">
    function change(part) {
      var term = $('#tnm_form').serializeJSON();
      console.log(term);

      $.post('/tnm', term, 
        function(data) {

          console.log(data);

          var el = document.getElementById(part+'_result');
          var text = data[part][0]["Result"];
          if (data[part].length>1) text = text + " (non conclusive)"
          el.innerHTML = text

          el = document.getElementById('tnm_result');
          text = data["TNM"][0]["Result"];
          if (data["TNM"][0]["Message"] != null) text = text + " (" + data["TNM"][0]["Message"] +")"
          el.innerHTML = text

          el = document.getElementById('SG_result');
          text = data["SG"][0]["Result"];
          el.innerHTML = text

          for (var key in data["SG"][0]) {
            if (key != "Result" && key != "Message") {
              el = document.getElementById('SG_' + key + '_result');
              text = data["SG"][0][key];
              el.innerHTML = text
              alert_text += key + ": " + text + "\n"
            }
          }

        }, "json");
    }
  </script>

</html>