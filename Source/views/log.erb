<html>
	<head>
		<title><%= R18n.t[:layout][:title] %></title>
		<link rel="stylesheet" href="/css/default.css" type="text/css">
		<link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
		<script src="/js/jquery-1.9.1.min.js" type="text/javascript"></script>
	</head>
	<body>
	    <div align = "center">
			<div style="width:90%" align="left">
				<h3>CanStaging log</h3>

				<table class="table" id = "log-table">
					<thead>
					<tr>
						<td><%= t[:get_log][:tumour_ID] %></td>
						<td><%= t[:get_log][:date_created] %></td>
						<td><%= t[:get_log][:site] %></td>
						<td><%= t[:get_log][:t] %></td>
						<td><%= t[:get_log][:n] %></td>
						<td><%= t[:get_log][:m] %></td>
						<td><%= t[:get_log][:tnm_result] %></td>
						<td><%= t[:get_log][:tnm_message] %></td>
						<td><%= t[:get_log][:sg_result] %></td>
						<td><%= t[:get_log][:sg_message] %></td>
						<td><%= t[:get_log][:simpg] %></td>
						<td><%= t[:get_log][:sg_range] %></td>
						<td><%= t[:get_log][:site_specific] %></td>
					</tr>
					</thead>
					<tbody>
					<% log.each do |entry|%>
					<% result = JSON.parse(entry[:result]) %>
						<% site_specific = result["SG"][0].keys - ["Result", "Message", "TNM", "T", "N", "M"] %>
						<tr>
							<td><%= entry[:tumour_id] %></td>
							<td><%= R18n.l entry[:created_at] %></td>
							<td><%= entry[:site] %></td>
							<td title="<%= result["T"][0]["Message"]%>"><%= result["T"][0]["Result"] %></td>
							<td title="<%= result["N"][0]["Message"]%>"><%= result["N"][0]["Result"] %></td>
							<td title="<%= result["M"][0]["Message"]%>"><%= result["M"][0]["Result"] %></td>
							<td><%= result["TNM"][0]["Result"] %></td>
							<td><%= result["TNM"][0]["Message"] %></td>
							<td><%= result["SG"][0]["Result"] %></td>
							<td><%= result["SG"][0]["Message"] %></td>
							<td><%= result["SimpG"] && result["SimpG"][0] ? result["SimpG"][0]["Result"] : ""%></td>
							<td><%= result["SGrange"] && result["SGrange"][0] ? result["SGrange"][0]["Result"] : "" %></td>
							<td><%= site_specific.map { |ss| "#{ss}: #{result['SG'][0][ss]}" }.join("; ") %></td>
						</tr>
					<% end %>
					</tbody>
				</table>
				<input type="button" value="<%= R18n.t[:get_log][:clear_log] %>" onClick="clear_log()" />
				<input type="button" value="<%= R18n.t[:get_log][:download_log] %>" onClick="download_log()" />
			</div>
		</div>
	</body>
	<script type="text/javascript">
	function clear_log(){
		if (confirm('Are you sure you want to delete your log?')) {
		    $.get("/clear_log", function(data) {
		        location.reload();
		    });
		} else {
		    // Do nothing!
		}
	}
	function download_log(){
		window.location = "/get_log.csv";
	}
	</script>
</html>