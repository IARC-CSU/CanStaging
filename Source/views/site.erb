<head>
  <title><%= site.site %></title>
  
  <script src="/js/jquery-1.9.1.min.js" type="text/javascript"></script>
  <meta http-equiv="X-UA-Compatible" content="IE=8" />
  <meta charset="UTF-8">
</head>

  <h1><%= site.site %></h1>
  <form name="tnm_form" action="/tnm" method="post" onsubmit="return validateForm()" id = "tnm_form">
    <input name="site" value="<%= site.site %>" hidden = true type = "hidden">
    <!-- <input name="key" value="<%= params[:key] %>" hidden = true type = "hidden"> -->
    <table id = <%= "\"#{site.css}_form\"" %> >
      <thead>
      <tr id = "identification">
        <td align="right">Tumour ID:</td>
        <td><input id = "tumour_id" name="tumour_id" type="text" title="THIS ID SHOULD NOT BE A PERSONAL IDENTIFIER."/><input id="autogenerate" title = "Auto-generate tumour IDs?"name = "auto_id" type="checkbox" onchange = "autogenerateUpdated()" checked = "checked">Auto</td>
      </tr>
      </thead>
      <% site.get_metas.each do |part, meta| %>
        <% unless meta.fields.empty? %>
        <thead>
        <tr id = "<%= part %>" onclick = "hide_unhide('<%= part %>')">
          <th><%= part %></th>
          <th class = "result" id = "<%= part %>_result">
          </th>
        </tr>
        <tbody id = "<%= part %>">
        <% meta.fields.values.sort_by(&:group).each do |field| %>
          <% unless field.type == :generated %>
            <tr id = "<%= site.css+"_group_" + (field.group.nil? ? "1" : field.group) %>">
              <% if field.type == :output %>
                <td class = "result_label" >
              <% else %>
                <td>
              <% end %>
              <%= field.display_text %></td>
              <% case field.type 
                when :boolean %>
                <td>
                  <input type="radio" name=<%= "\"data[#{part}[#{field.name}]]\"" %> value="T" onchange = "change('<%= part %>', <%= "\'data[#{part}[#{field.name}]]\'" %>)"><%= R18n.t[:yes] %>
                  <input type="radio" name=<%= "\"data[#{part}[#{field.name}]]\"" %> value="F" onchange = "change('<%= part %>', <%= "\'data[#{part}[#{field.name}]]\'" %>)" checked><%= R18n.t[:no] %>
                </td>
              <% when :dictionary %>
              <td>
                  <select name=<%= "\"data[#{part}[#{field.name}]]\"" %> onchange = "change('<%=part  %>', <%= "\'data[#{part}[#{field.name}]]\'" %>)">
                    <% unless part == "M" %>
                    <option value='' disabled selected style='display:none;'><%= R18n.t[:site][:please_choose] %> </option>
                    <% end %>
                    <% field.dictionary.table.each do |key, value| %>
                      <option value=<%= "\"#{key}\"" %> title=<%= "\"#{value}\"" %> ><%= value %></option>
                    <% end %>
                  </select>
                  <span onclick="reset(<%= "\'data[#{part}[#{field.name}]]\'" %>, '<%= part %>');">
                    <%= R18n.t[:site][:reset] %>
                  </span>
               </td>
              <% when :number %>
              <td>
                <input name=<%= "\"data[#{part}[#{field.name}-number]]\"" %> type="number" step = <%= field.ranges.float? ? 0.1 : 1 %> min = <%= field.ranges.min_min %> max = <%= field.ranges.max_max %> title=<%= "\"#{field.ranges}\"" %> onchange = "change('<%= part %>', <%= "\'data[#{part}[#{field.name}]]\'" %>)"/>
                </td>
              <% when :output %>
                  <td class = "result" id = "<%= part + '_' + field.name %>_result"></td>
              <% else %>
              <td>
                <input name=<%= "\"data[#{part}[#{field.name}]]\"" %> type="text"  onchange = "change('<%= part %>', <%= "\'data[#{part}[#{field.name}]]\'" %>)"/>
                </td>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      <% end %>
      </tbody>
      <% end %>
      <tr id = "SGrange">
        <th>SG range</th>
        <th class = "result" id = "SGrange_result"></th>
      </tr>
      <tr id = "result">
        <th>TNM</th>
        <th class = "result" id = "TNM_result"></th>
      </tr>
      <tr id = "buttons">
        <td></td>
        <td align="right">
          <input type="button" value="Get log" onClick="get_log()" />
          <input type="button" value="Reset Form" onClick="clear_form(this)" />
          <input type="submit" value="Submit" />
        </td>
      </tr>
    </table>
  </form>

  </body>

  <script type="text/javascript">

    function get_log(){
      window.open("/get_log", "_blank");
    }

    function hide_unhide(part) {
     $('tbody#'+part).toggle( {easing: 'swing'} ); 
     /*$('tbody#'+part).toggle( 'scale', { percent: 0 }, 500 );*/
    }

    function next_tumour_id(current) {
      return ""+(parseInt(current)+1);
    }

    function setDefaultResults(){
      var results = $(".result");
      for(var i = 0; i<results.length; i++) {
        var part = results[i].id.split("_")[0]
        var text = getDefaultResult(part)
        results[i].textContent = text;
      }
    }

    function getDefaultResult(part) {
      var text = "";
      // console.log(results[i]);
      if(part == "T"){
        text = "TX";
      } else if (part == "N"){
        text = "NX"
      } else if (part == "M"){
        text = "M0"
      }
      return text;
    }

    function clear_form(d) {
      var tumour_id = $("#tumour_id")[0].value;
      var autogenerate = $("#autogenerate").prop('checked');
      d.form.reset();

      setDefaultResults();

      if (autogenerate) {
        $("#autogenerate").prop('checked', true);
        $.get("/next_numeric_id", function(data) {
          $("#tumour_id")[0].value = data;
        });
      } else {
        $("#autogenerate").prop('checked', false);
      }

/*      var parts = ["T", "N", "M"];
      for (var i in parts) {
        part = parts[i];
        var element = $("#"+part+"_result");
        if (element != null) {
          if (part == "T" || part == "N"){
            element[0].textContent = part + "X";
          } else {
            element[0].textContent = part + "0";
          }
        }
      }*/
    }

    function autogenerateUpdated() {
      // if autogenerate selected:
      if ($("#autogenerate").prop('checked')) {
        var tumour_id = $("#tumour_id")[0].value;
        if (tumour_id.length == 0 || parseInt(tumour_id)==NaN) {
          $.get("/next_numeric_id", function(data) {
            $("#tumour_id")[0].value = data;
          });
        } else {
          // $("#tumour_id")[0].value = next_tumour_id(tumour_id);
        }
      }
      $("#tumour_id").attr('readonly', $("#autogenerate").prop('checked'));
    }

    function validateForm() {
      return true; // short curcuit the form validation for now...
      <% site.get_metas.each do |part, meta| %>
        <% meta.fields.values.each do |field| %>
          <% case field.type 
          when :boolean %>
            var radios = document.getElementsByName(<%= "\"data[#{part}[#{field.name}]]\"" %>);
            var formValid = false;
            var i = 0;
            while (!formValid && i < radios.length) {
                if (radios[i].checked) formValid = true;
                i++;        
            }
            if (!formValid) { alert (<%= "\" '#{field.display_text}' must be checked.\"" %>);
              return false;
            }
          <% when :number %>
            var x = document.forms["tnm_form"][<%= "\"data[#{part}[#{field.name}-number]]\"" %>].value;
            if (x==null || x=="")
            {
            alert(<%= "\" '#{field.display_text}' must be filled out.\"" %>);
            return false;
            }
              if (x < <%=field.ranges.min_min%> || x > <%=field.ranges.max_max%>) { alert (<%= "\" '#{field.display_text}' outside of scope (#{field.ranges}).\"" %>); 
              return false;
            }
          <% when :generated %>
          // Do nothing
          <% else %>
            var x = document.forms["tnm_form"][<%= "\"data[#{part}[#{field.name}]]\"" %>].value;
            if (x==null || x=="")
            {
            alert(<%= "\" '#{field.display_text}' must be filled out.\"" %>);
            return false;
            }
          <% end %>
        <% end %>
      <% end %>
    }

    function resultsToForm(data){
      setDefaultResults();
      var keys = Object.keys(data);
      console.log(data);
      var results = {};
      var alertText = "<b>Results:</b>";
      for (var i = 0; i<keys.length; i ++) {
        var part = keys[i];
        var el = document.getElementById(part+'_result');
        var text = data[part][0]["Result"];
        el.innerHTML = text;
        if (data[part].length>1 && !unique_result(data[part])) { 
          text = getDefaultResult(part);
          el.innerHTML = text;
        };
        results[part] = text;
        if (part == "SG") {
          if (data["SG"].length>1) {
            text = "UNK"
          }
          alertText += "<br>SG: " + text;
          for (var key in data["SG"][0]) {
            if (key != "Result" && key != "Message") {
              el = document.getElementById('SG_' + key + '_result');
              text = data["SG"][0][key];
              if(data["SG"].length>1 && !unique_result(data["SG"])){
                text = "";
              }
              if (el!=null) {
                el.innerHTML = text;
                if (text.length > 0){
                  alertText += "<br>" + key + ": " + text;
                }
              }
            }
          }
        } else if (part != "TNM"){
          alertText += "<br>" + part + ": " + text;
        }
      }
      var el   = document.getElementById('TNM_result');
      var text = results['T']+results['N']+results['M'];
      el.title = data["TNM"][0]["All results"].join("\n");
      el.innerHTML = text;
      alertText += "<br>TNM: "+ text;
      return alertText;
    }


    function change(part, control) {
      // var term = $('#tnm_form').serializeJSON();
      var term = form_to_data('#tnm_form');

      term["data[control]"] = control; 
      console.log(term);

      $.post('/tnm', term, 
        function(data) {
          resultsToForm(data);
        }, "json");
    }

    function unique_result(array) {
      var lookfor = array[0].Result;
      var i = 1;
      var unique = true;
      while (i<array.length){
        if (array[i++].Result != lookfor) {
          unique = false;
          break;
        }
      }
      return unique;
    };

    /* attach a submit handler to the form */
    $("#tnm_form").submit(function(event) {
      event.preventDefault();
      // var term = $('#tnm_form').serializeJSON();
      var term = form_to_data('#tnm_form');
      $.post('/tnm_submit', term, 
        function(data) {
        var alert_text = resultsToForm(data);
        bootbox.alert(alert_text);
        }, "json");
    });


  function form_to_data(form_id){
    var form = $(form_id)[0];
    var data = {};
    for (var i = 0, ii = form.length; i < ii; ++i) {
      var input = form[i];
      if (input.name) {
        if(input.type =="radio" ) {
          if (input.checked){
            data[input.name] = input.value;
          }
        } else {
          data[input.name] = input.value;
        }
      }
    }
    return data;
  }

  //update the auto-generate-stuff
  autogenerateUpdated();

  document.title = "CanStaging - <%= site.site %>";
  setDefaultResults();
  // this overrides the default...
  // function help_alert() {
  //   bootbox.alert("Help text for <%= site.site %>");
  // }

  function reset(selectBoxName, part) {
    // console.log(selectBoxName);
    $(document.getElementsByName(selectBoxName)).prop('selectedIndex',0);
    change(part, selectBoxName);
  }

  </script>
