<form action='/login/attempt' method='post'>
  <div class="form-group">
    <!-- <label for="key">Key</label> -->
    <input type="password" name='key' placeholder="key" autofocus class="form-control" id="key" aria-describedby="keyHelp" placeholder="Enter key">
    <small id="emailHelp" class="form-text text-muted">Enter your unique key.</small>
  </div>
  <input class="btn btn-primary" type='submit' value='<%= R18n.t[:home][:log_in] %>'>
</form>