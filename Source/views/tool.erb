<link rel="stylesheet" href="/css/default.css" type="text/css">

<% tnm_versions = {'v8' => 'TNM8', 'v7'=> 'TNM7', 'eTNM'=> 'Essential TNM', 'Toronto' => 'Toronto', 'v5' => 'TNM5' }%>

<h1>CanStaging<sup>+</sup></h1>
<hr width="75%" />
<p class="welcome"><%= R18n.t[:home][:welcome] %></p>
<hr width="75%" />
<h4>​Sites <%= tnm_versions[session[:tnm_version]]  %></h4>

<%= R18n.t[:home][:no_sites_translated] if sites.nil? || sites.empty? %>

<!-- <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
  <% sites.each do |site| %>
    <a class="nav-link" href = "/site/<%= "#{site.default_name.downcase}" %>" id = "<%= site.css %>_menu"><%= site.site.capitalize %></a>
  <% end %>
</div>
-->

<div class="card-columns">
  <% sites.each do |site| %>
  <a href = "/site/<%= "#{site.default_name.downcase}" %>">
    <div class="card">
        <div class="card-header" id = "<%= site.css %>_menu">
          <%= site.site.capitalize %>
        </div>
      <div class="card-body">
        <!-- <h5 class="card-title"><%= site.site.capitalize%> </h5> -->
        <!-- <p class="card-text">Info?</p> -->
        <!-- <a href="#" class="btn btn-primary">Go</a> -->
        <% if site.default_name.downcase == 'colorectal' && session[:tnm_version] == 'v7' %>
          <p class="card-text"><small class="text-muted"><%= tnm_versions['v5']  %> </small></p>
        <% else %>
          <p class="card-text"><small class="text-muted"><%= tnm_versions[session[:tnm_version]]  %> </small></p>
        <% end %>
      </div>
    </div>
  </a>
  <% end %>
</div>

<hr width="75%" />

