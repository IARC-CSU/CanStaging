<!DOCTYPE html>
<html>
  <head>
  	<title><%= R18n.t[:layout][:title] %></title>
    <meta http-equiv="X-UA-Compatible" content="IE=8" />
    <script src="/vendor/jquery-1.9.1.min.js" type="text/javascript"></script>
    <script src="/vendor/bootstrap/js/bootstrap.min.js"></script>
    <script src="/vendor/ladda/spin.min.js"></script>
    <script src="/vendor/ladda/ladda.min.js"></script>
    <!-- <link rel="stylesheet" href="/vendor/ladda/demo.css"> -->
    <link rel="stylesheet" href="/vendor/ladda/ladda.min.css">
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/default.css" type="text/css">
	  <link rel="stylesheet" href="/vendor/fontawesome/css/font-awesome.min.css">
	  <script src="/js/bootbox.min.js"></script>
  </head>
  <body style="padding-top: 50px;">

    <script type="text/javascript">
	  function about_alert() {
	  	bootbox.alert("<%= R18n.t[:layout][:about_text] %>"
    );
	  }
	  function help_alert() {
	  	bootbox.alert("<%= R18n.t[:layout][:help_text] %>");
	  }
 	 </script>

    <div class="navbar navbar-fixed-top">
      <div class="navbar-inner">
        <div class="container">
            <a class="brand" href="/tool">
              CanStaging
            </a>

            <ul class="nav">
              <li><a href="/tool"><%= R18n.t[:layout][:home] %></a></li>
              <li class="dropdown">
                <a href="#"
                      class="dropdown-toggle"
                      data-toggle="dropdown">
                      <%= R18n.t[:layout][:sites] %>
                      <b class="caret"></b>
                </a>
                <ul class="dropdown-menu">
                	<% sites.each do |site| %>
        						<li>
        							<a id = "<%= site.css %>_group_1" href = "/site/<%= "#{site.site.downcase}" %>"><%= site.site.capitalize %></a>
        						</li>
					       <% end %>
                </ul>
              </li>
            <li><a href="/upload" title = "Upload a file for batch processing."><%= R18n.t[:layout][:upload] %></a></li>
              <li><a href="/get_log" target = "_blank"><%= R18n.t[:layout][:get_log] %></a></li>
            </ul>
       		<ul class="nav pull-right">
                <li class="dropdown">
      <a href="#"
        class="dropdown-toggle"
        data-toggle="dropdown">
        <%= R18n.t[:layout][:language_select] %>
      <b class="caret"></b>
      </a>
      <ul class="dropdown-menu">
        <% r18n.available_locales.each do |loc| %>
          <li>
            <%= "<a href=\"/locale/#{loc.code}\">#{loc.title}</a>" %> 
          </li>
        <% end %>                   
      </ul>
    </li>
              <li class="dropdown">
                <a href="#"
                      class="dropdown-toggle"
                      data-toggle="dropdown">
                      ?
                      <b class="caret"></b>
                </a>
                <ul class="dropdown-menu">
                    <li><a href="#" role="button" onclick="help_alert()"><%= R18n.t[:layout][:help] %></a></li>
                    <li><a href="#" role="button" onclick="about_alert()"><%= R18n.t[:layout][:about] %></a></li>
                </ul>
              </li>

              <li class="dropdown">
                <a href="#"
                      class="dropdown-toggle"
                      data-toggle="dropdown">
                      <%= !session[:user].nil? ? session[:user].username : "" %>                      
                      (<%= !session[:key].nil? && session[:key].split("-").length>1 ? session[:key].split("-").last + " - ": "" %><%= !session[:user].nil? && !session[:user].role.nil? ? R18n.t[:layout][session[:user].role.to_sym] :  R18n.t[:layout][:user] %>)
                      <b class="caret"></b>
                </a>
                <ul class="dropdown-menu">
                      <li><a href="/logout"><%= R18n.t[:layout][:log_out] %></a></li>
                </ul>
              </li>
            </ul>
        </div>
      </div>
    </div>
	<div class="container">
		<%if @error then %>
			<div class="alert alert-error"><%= @error %></div>
		<% end %>
    <%if session[:message] then %>
      <div class="alert alert-success"><%= session[:message] %></div>
      <% session[:message] = nil %>
    <% end %>
    <%if session[:error] then %>
      <div class="alert alert-error"><%= session[:error] %></div>
      <% session[:error] = nil %>
    <% end %>
    	<%= yield.force_encoding(Encoding::UTF_8) %>
	</div>
  </body>
</html>