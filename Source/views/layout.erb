<!DOCTYPE html>
<html>
  <head>
  	<title>The Cancer Staging Tool</title>
    <script src="/vendor/jquery-1.9.1.min.js" type="text/javascript"></script>
    <script src="/vendor/bootstrap/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/default.css" type="text/css">
	  <link rel="stylesheet" href="/vendor/fontawesome/css/font-awesome.min.css">
	  <script src="/js/bootbox.min.js"></script>
  </head>
  <body style="padding-top: 50px;">

    <script type="text/javascript">
	  function about_alert() {
	  	bootbox.alert("<div id = \"about\"> <h1>COPYRIGHT</h1> <p>This product is protected by copyright. Except as specifically permitted, no portion of this tool may be distributed or reproduced by any means, or in any form, without the NICR's prior written permission.</p> <p>Copyright © The Queen's University of Belfast, 2013 - Northern Ireland Cancer Registry, The Queen's University of Belfast, nicr@qub.ac.uk. All rights reserved.<br></p> <h1>WARRANTIES, DISCLAIMERS AND LIABILITY LIMITATIONS</h1> <p>THIS TOOL IS PROVIDED \"AS IS\" WITHOUT WARRANTY OR CONDITIONS OF ANY KIND, EITHER EXPRESS OR IMPLIED, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OR CONDITIONS OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, OR NON-INFRINGEMENT.</p> <p>THE NICR ASSUMES NO RESPONSIBILITY FOR ERRORS OR OMISSIONS IN THIS TOOL.</p> <p>IN NO EVENT SHALL THE NICR BE LIABLE FOR ANY SPECIAL, INCIDENTAL, INDIRECT OR CONSEQUENTIAL DAMAGES OF ANY KIND, OR ANY DAMAGES WHATSOEVER (INCLUDING WITHOUT LIMITATION, THOSE RESULTING FROM: (1) RELIANCE ON THE MATERIALS PRESENTED, (2) COSTS OF REPLACEMENT GOODS, (3) LOSS OF USE, DATA OR PROFITS, (4) DELAYS OR BUSINESS INTERRUPTIONS, (5) AND ANY THEORY OF LIABILITY, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF INFORMATION) WHETHER OR NOT THE NICR HAS BEEN ADVISED OF THE POSSIBILITY OF SUCH DAMAGES.</p> <p>THIS TOOL COULD INCLUDE TECHNICAL OR OTHER INACCURACIES. HOWEVER, THE NICR MAKES NO COMMITMENT TO PROVIDE UPDATES.</p> </div>"
    );
	  }
	  function help_alert() {
	  	bootbox.alert("<b>Help</b><br>The Cancer Staging Tool calculates TNM, Stage, Grade, and other site-specific stage scores from raw information entered by the user. <br>Please <a href=\"/media/StagingToolHelp.pdf\">Download a PDF guide</a> with more information.");
	  }
 	 </script>

    <div class="navbar navbar-fixed-top">
      <div class="navbar-inner">
        <div class="container">
            <a class="brand" href="/tool">
              The Cancer Staging Tool
            </a>

            <ul class="nav">
              <li><a href="/tool">Home</a></li>
              <li class="dropdown">
                <a href="#"
                      class="dropdown-toggle"
                      data-toggle="dropdown">
                      Sites
                      <b class="caret"></b>
                </a>
                <ul class="dropdown-menu">
                	<% sites.each do |site| %>
						<li>
							<a id = "<%= site %>_group_1" href = "/site/<%= "#{site.downcase}" %>"><%= site.capitalize %></a>
						</li>
					<% end %>
                </ul>
              </li>
              <li><a href="/get_log">Get log</a></li>
            </ul>
       		<ul class="nav pull-right">
              <li class="dropdown">
                <a href="#"
                      class="dropdown-toggle"
                      data-toggle="dropdown">
                      ?
                      <b class="caret"></b>
                </a>
                <ul class="dropdown-menu">
                    <li><a href="#" role="button" onclick="help_alert()">Help</a></li>
                    <li><a href="#" role="button" onclick="about_alert()">About</a></li>
                </ul>
              </li>
              <li class="dropdown">
                <a href="#"
                      class="dropdown-toggle"
                      data-toggle="dropdown">
                      User
                      <b class="caret"></b>
                </a>
                <ul class="dropdown-menu">
                      <li><a href="/logout">Logout</a></li>
                </ul>
              </li>
            </ul>
        </div>
      </div>
    </div>
	<div class="container">
		<%if @error then %>
			<div class="alert alert-error"><%=@error%></div>
		<% end %>
    	<%= yield %>
	</div>
  </body>
</html>