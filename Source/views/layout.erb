<!DOCTYPE html>
<html lang="<%= session[:locale]%>">
  <head>
  	<title><%= R18n.t[:layout][:title] %></title>
    <meta http-equiv="X-UA-Compatible" content="IE=8" />
    <meta name="description" content="CanStaging+ is a tool that automatically calculates the stage classification for a range of tumour sites based on the most recent guidelines.">
    <meta name="keywords" content="cancer, tumour, tumor, malign, malignancy, malignant, stage, staging, classification, grade, grading, tnm, node, metastasis, calculator, tool, system, application, guide, guideline, assessment, criteria, criterion, surveillance, registry, surveillance, epidemiology, oncology, pathology, radiology, histology">
    <meta charset="UTF-8">
    <script src="/vendor/jquery-3.4.1.min.js" type="text/javascript"></script>
    <script src="/vendor/popper.min.js" type="text/javascript"></script>
    <script src="/vendor/bootstrap/js/bootstrap.min.js"></script>
	  <script src="/js/bootbox.min.js"></script>
    <script src="/js/bootbox.locales.min.js"></script>

    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/default.css" type="text/css">
	  <link rel="stylesheet" href="/vendor/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="/vendor/fontawesome/css/solid.min.css">
    <!-- Matomo -->
    <script>
      var _paq = window._paq = window._paq || [];
      /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
      _paq.push(['trackPageView']);
      _paq.push(['enableLinkTracking']);
      (function() {
        var u="https://iarc.matomo.cloud/";
        _paq.push(['setTrackerUrl', u+'matomo.php']);
        _paq.push(['setSiteId', '2']);
        var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
        g.async=true; g.src='//cdn.matomo.cloud/iarc.matomo.cloud/matomo.js'; s.parentNode.insertBefore(g,s);
      })();
    </script>
    <!-- End Matomo Code -->
  </head>
  <body>

<script type="text/javascript">
//	  function about_alert() {
//	  	bootbox.alert("<%= R18n.t[:layout][:about_text] %>");
//	  }
	  function help_alert() {
	  	bootbox.alert("<%= R18n.t[:layout][:help_text] %>");
	  }
 	 </script>

    
	<div class="container" id="app">

    <div class="navbar navbar-expand-lg navbar-dark bg-dark">

      <a class="navbar-brand" href="/tool">CanStaging<sup>+</sup></a>

      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNavDropdown">

            <ul class="navbar-nav mr-auto">
              <li class="nav-item active">
                <a class="nav-link" href="/tool"><%= R18n.t[:layout][:home] %> <span class="sr-only">(current)</span></a>
              </li>
              <li class="nav-item dropdown">

                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <%= R18n.t[:layout][:staging_system] %>
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                  <% systems.each do |system| %>
                    <a class="dropdown-item" href = "/tool?tnm_version=<%=system%>" > <%= Site.staging_system_name(system, :desc) %> </a>
                  <% end %>
                </div>
              </li>
              <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <%= R18n.t[:layout][:sites] %>
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                  <% sites.each do |site| %>
                  <a class="dropdown-item" id="<%= site.css %>_menu" href="/site/<%= "#{site.default_name.downcase}" %>"><%= site.site %></a>
                 <% end %>
                </div>
              </li>

              
              <% unless session[:key].nil? %>
                <li class="nav-item">
                  <a class="nav-link" href="/upload" title = "Upload a file for batch processing."><%= R18n.t[:layout][:upload] %></a>
                </li>
              <% end %>

            <% unless session[:key].nil? %>
              <% if session[:in_memory] %>
                <li class="nav-item">                
                  <a class="nav-link" href="/get_log" target = "_blank" title = "<%= R18n.t[:layout][:get_temp_log_title] %>" ><%= R18n.t[:layout][:get_temp_log] %></a>
                </li>
              <% else %>
                <li class="nav-item">
                  <a class="nav-link" href="/get_log" target = "_blank" title = "<%= R18n.t[:layout][:get_log_title] %>" ><%= R18n.t[:layout][:get_log] %></a>
                </li>
              <% end %>
            <% end %>
            </ul>
            <ul class="navbar-nav">
                <% if locales.length > 1 %>
               <li class="nav-item dropdown">

                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <%= R18n.t[:layout][:language_select] %>
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                  <% r18n.available_locales.each do |loc| %>
                    <a class="dropdown-item"
                      <%= " href=\"/locale/#{loc.code}\">#{loc.title}" %> 
                    </a>
                  <% end %>                   
                </div>
              </li> 
                <% end %>
              <li class="nav-item dropdown">

                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                      ?
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                    <a class="dropdown-item" href="#" role="button" onclick="help_alert()"><%= R18n.t[:layout][:help] %></a>
                    <a class="dropdown-item" href="/about"><%= R18n.t[:layout][:about] %></a>
                    <a class="dropdown-item" href="/register">Register</a>
                    <a class="dropdown-item" href="/feedback">Feedback</a>
                    <a class="dropdown-item" href="/changelog">Changelog</a>
                </div>
              </li>

              <li class="nav-item dropdown">
                <% if session[:key].nil? %>
                  <a class="nav-link" href="/login/form" title = "<%= R18n.t[:layout][:log_in] %>" ><%= R18n.t[:layout][:log_in] %></a>    
                <% else %>
                  <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <%= !session[:user].nil? ? session[:user].username : "" %>                      
                        (<%= !session[:key].nil? && session[:key].split("-").length>1 ? session[:key].split("-").last + " - ": "" %><%= !session[:key].nil? && !session[:user].nil? && !session[:user].role.nil? ? R18n.t[:layout][session[:user].role.to_sym] : R18n.t[:layout][:user] %>)
                  </a>
                  <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                    <a class="dropdown-item" href="/logout"><%= R18n.t[:layout][:log_out] %></a>
                    <% if session[:local] %>
                      <a class="dropdown-item" href="/shutdown"><%= R18n.t[:layout][:shutdown] %></a>
                    <% end %>
                  </div>
                <% end %>
              </li>
            </ul>
        </div>
      </div>


		<%if @error then %>
			<div class="alert alert-danger" role="alert"><%= @error %></div>
		<% end %>
    <%if session[:message] then %>
      <div class="alert alert-success alert-dismissible fade show" role="alert"><%= session[:message] %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <% session[:message] = nil %>
    <% end %>
    <%if session[:error] then %>
      <div class="alert alert-danger" role="alert"><%= session[:error] %></div>
      <% session[:error] = nil %>
    <% end %>
    	<%= yield.force_encoding(Encoding::UTF_8) %>
	</div>
  </body>
</html>
