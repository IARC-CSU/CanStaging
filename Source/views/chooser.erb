<link rel="stylesheet" href="/css/default.css" type="text/css">

<h1>CanStaging<sup>+</sup></h1>
<hr width="75%" />
<p class="welcome"><%= R18n.t[:home][:welcome] %></p>
<hr width="75%" />
<% 

translations = {
	'eTNM' => { label: 'Essential TNM', desc: 'Essential TNM'} ,
	'v7'   => { label: 'TNM edition 7', desc: 'TNM edition 7'} ,
	'v8'   => { label: 'TNM edition 8', desc: 'TNM edition 7'} ,
	'Toronto' => { label: 'Toronto', desc: 'Childhood Cancer Staging'} 
}

%>
<h2>Please chose staging system: </h2>
<br>
<div class="card-columns">
  <% systems.each do |system| %>
  <a href = '/tool?tnm_version=<%= system %>'>
    <div class="card">
        <div class="card-header" id = "<%= system %>_menu">
          <%= translations[system][:label] %>
        </div>
        <div class="card-body">
      	  <%= translations[system][:desc] %>
        </div>
    </div>
  </a>
  <% end %>
</div>